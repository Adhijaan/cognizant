# Copy to .env (repo root) and fill in. The server reads it; the phone only ever gets a conversation token.
# See design.md §15 for which link (L1–L11) uses each variable.

PORT=3000

# L1, L4, L8 — the tunnel's https URL (no trailing slash). wss://<host>/ws is derived for the Speech Engine.
# `npm run tunnel:sync` fills this in from ngrok's local API and updates the engine's wsUrl.
PUBLIC_URL=

# L4, L8 — ElevenLabs API key. Also the secret the SDK uses to verify inbound Speech Engine connections.
ELEVENLABS_API_KEY=
# L3, L4, L8 — seng_..., printed (and written here) by `npm run engine:create`.
SPEECH_ENGINE_ID=
# Voice for the Speech Engine and the earcon clips (any voice ID from your ElevenLabs voice library).
ELEVENLABS_VOICE_ID=

# L5 — Gemini (Google AI Studio key).
GEMINI_API_KEY=
# Confirm against `npm run models:list` (GET /v1beta/models).
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL=gemini-flash-latest

# L6, L7 — Google Maps Platform key, restricted to Routes API + Places API (New).
GOOGLE_MAPS_API_KEY=

# L7 — Places bias / campus scope. Diag ≈ 42.277, -83.738.
CAMPUS_LAT=42.277
CAMPUS_LNG=-83.738
PLACES_RADIUS_M=1500

# L11 — where recordings are written (phone opened with ?record=1) and read by `npm run replay`.
REPLAY_DIR=recordings

# Horizontal field of view of the camera in portrait, degrees. Measure once on the actual phone (design.md §6).
CAMERA_HFOV_DEG=50
# Per-session cap on Gemini calls (cost guard, design.md §13).
SESSION_GEMINI_CAP=1500
